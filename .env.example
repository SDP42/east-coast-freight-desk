# DATABASE_URL: leave unset for local dev — it defaults to an absolute path at
# backend/freight_forecast.db (SQLite, zero setup). For a real Postgres
# deployment (ideally with the TimescaleDB extension for the freight_rates
# time-series table), set it explicitly, e.g.:
# DATABASE_URL=postgresql+psycopg2://freight:freight@localhost:5432/freight_forecast

REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=changeme-dev-secret

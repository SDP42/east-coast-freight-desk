# Copy to .env for local development. Never commit .env.

# Leave DATABASE_URL unset locally: it defaults to backend/freight_forecast.db (SQLite, zero setup).
# For Neon/Postgres, paste the connection string exactly as Neon shows it; "postgresql://" is fixed up automatically.
# DATABASE_URL=postgresql://user:password@ep-xxxx.aws.neon.tech/neondb?sslmode=require

# Optional. Without Redis the response cache runs in process memory.
# REDIS_URL=redis://localhost:6379/0

# Required when ENVIRONMENT=production (32+ random characters). Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=changeme-dev-secret
ENVIRONMENT=development

# JSON list of allowed browser origins, e.g. ["https://your-app.vercel.app"]
# CORS_ORIGINS=["http://localhost:5173"]
